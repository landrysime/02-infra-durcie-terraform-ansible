## Regles d'audit CIS Debian 12 (section 4.1) - fichier charge par auditd
## Surveille les evenements de securite cles.

# CIS 4.1.3 - Modifications de la date/heure systeme
-a always,exit -F arch=b64 -S adjtimex,settimeofday -k time-change
-w /etc/localtime -p wa -k time-change

# CIS 4.1.4 - Modifications des utilisateurs/groupes
-w /etc/group -p wa -k identity
-w /etc/passwd -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/sudoers -p wa -k identity
-w /etc/sudoers.d/ -p wa -k identity

# CIS 4.1.5 - Modifications de l'environnement reseau
-w /etc/hosts -p wa -k system-locale
-w /etc/network/ -p wa -k system-locale

# CIS 4.1.7 - Modifications des controles d'acces (DAC)
-a always,exit -F arch=b64 -S chmod,fchmod,chown,fchown,lchown -F auid>=1000 -F auid!=4294967295 -k perm_mod

# CIS 4.1.9 - Tentatives d'acces non autorisees aux fichiers
-a always,exit -F arch=b64 -S open,openat,creat -F exit=-EACCES -F auid>=1000 -F auid!=4294967295 -k access
-a always,exit -F arch=b64 -S open,openat,creat -F exit=-EPERM -F auid>=1000 -F auid!=4294967295 -k access

# CIS 4.1.10 - Utilisation de commandes privilegiees (sudo)
-w /var/log/sudo.log -p wa -k actions
-w /usr/bin/sudo -p x -k privileged

# CIS 4.1.11 - Montage de systemes de fichiers
-a always,exit -F arch=b64 -S mount -F auid>=1000 -F auid!=4294967295 -k mounts

# CIS 4.1.12 - Suppressions de fichiers par les utilisateurs
-a always,exit -F arch=b64 -S unlink,unlinkat,rename,renameat -F auid>=1000 -F auid!=4294967295 -k delete

# CIS 4.1.16 - Rendre la configuration d'audit immuable (doit rester en dernier)
-e 2
